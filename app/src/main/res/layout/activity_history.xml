<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Scan history"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/compareToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#1F2937"
            android:text="Compare"
            android:textColor="#FFFFFF" />
    </RelativeLayout>

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/historyEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="No scans yet.\nSearch or scan a product and it will show up here."
        android:textAlignment="center"
        android:textColor="#6B7280"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Compare action bar (selection mode, 2 selected) -->
    <LinearLayout
        android:id="@+id/compareActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/compareGoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#166534"
            android:text="Compare selected"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
